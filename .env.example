# 내 노트북에서 쓰는 값 (각자 본인 출입증 키)
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# DB (로컬 SSH 터널: 127.0.0.1:3307 / Bastion: DB 사설 IP:3306)
FINSH_DB_HOST=
FINSH_DB_PORT=3306
FINSH_DB_USER=finsh
FINSH_DB_NAME=finsh
FINSH_DB_PASSWORD=

# 프로그램용 출입증 키 (Bastion에서만 채움)
FINSH_SCANNER_ACCESS_KEY=
FINSH_SCANNER_SECRET_KEY=
FINSH_OPERATOR_ACCESS_KEY=
FINSH_OPERATOR_SECRET_KEY=
FINSH_REAPER_ACCESS_KEY=
FINSH_REAPER_SECRET_KEY=

# Terraform 기록 조회 (미설정 시 settings.yaml의 tfstate_bucket 사용)
FINSH_TFSTATE_BUCKET=finsh-tfstate-1com4soft

# 알림
SLACK_WEBHOOK_URL=

# 스위치
FINSH_DRY_RUN=1
FINSH_SOURCE=fake

# Confirmed NCP resource numbers for real deletion only (comma separated)
